pipeline {
    agent any

    stages {
        stage('compile') {
            steps {
                sh 'javac Main.java'
                // Add build steps here
            }
        }
        stage('run') {
            steps {
                sh 'java Main.java'
                // Add test steps here
            }
        }
   
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}